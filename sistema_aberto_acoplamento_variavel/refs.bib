@misc{Anwar2025,
abstract = {This work presents a comprehensive study of atom–{\ldots}eld interactions by examining how subtle variations in key parameters a&frasl;ect quantum dynamics. In our investigation, the time-dependent Stark shift (SS) is systematically varied from low (approximately 0:3) to high (around 3) values. Under weak Stark modulation, the system closely mirrors the traditional Jaynes–Cummings model, displaying smooth Rabi oscillations and modest ‡uctuations in quantum measures such as the Quantum Fisher Information (QFI), Von Neumann Entropy (VNE), and Negativity (Neg). As the Stark parameter increases, the atom and {\ldots}eld are driven in and out of resonance more abruptly, leading to rapid, high-amplitude bursts of quantum entanglement (QE) and marked shifts in the Geometric Phase. The study further explores the role of a small nonzero initial phase ( = =4), which subtly alters the interference between the atom and {\ldots}eld. This additional phase results in slight shifts in the timing and magnitude of QE peaks when compared with a purely real initial state. Additionally, the incorporation of detuning and atomic motion introduces o&frasl;-resonant e&frasl;ects and vibrational sidebands, respectively. These elements further complicate the energy exchange process and enrich the overall dynamics. Overall, the results underscore that even slight modi{\ldots}cations in external parameters can lead to signi{\ldots}cant variations in QE behavior and phase evolution, o&frasl;ering valuable insights for the {\ldots}ne-tuning of quantum systems in advanced technological application.},
author = {Anwar, Syed Jamal and Ramzan, M Ramzan and Ibrahim, M and Khan, M Khalid},
doi = {10.20944/preprints202504.1160.v1},
file = {:C\:/Users/takaj/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Anwar et al.. Unknown. 2025. Chaotic and Stable Regimes of Quantum Entanglement Under Stark Modulation and Detuning Without Rotating Wav.pdf:pdf},
month = {apr},
title = {{Chaotic and Stable Regimes of Quantum Entanglement Under Stark Modulation and Detuning Without Rotating Wave Approximation}},
url = {https://www.preprints.org/manuscript/202504.1160/v1},
year = {2025}
}
