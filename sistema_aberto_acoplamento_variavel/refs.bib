@article{Zener1932,
abstract = {The crossing of energy levels has been a matter of considerable discussion. The essential features may be illustrated in the crossing of a polar and homopolar state of a molecule. Let $\psi$ 1 ( x /R), $\psi$ 2 ( x /R) be two electronic eigenfunctions of a molecule with stationary nuclei. Let these eigenfunctions have the property that for R≫R 0 , $\psi$ 1 has polar characteristics, $\psi$ 2 homopolar; while at R≪R 0 , $\psi$ 2 has polar characteristics, $\psi$ 1 homopolar. In the region R=R 0 these two eigenfunctions may be said to exchange their characteristics.},
author = {Zener, Clarence},
doi = {10.1098/rspa.1932.0165},
