@article{Tao2026,
abstract = {We introduce a paradigm of spectral engineering for environmental noise aimed at actively protecting quantum coherence in solid-state qubits. Through the analytical study of the decoherence process induced by cavity leakage in a double-quantum-dot–cavity system, we demonstrate high-frequency charge noise can effectively freeze the quantum state and protect quantum coherence. Then, departing from conventional noise-suppression strategies, we propose to synthesize tailored noise spectra by linearly mixing multiple Ornstein–Uhlenbeck (OU) stochastic processes. The composite noise is designed to possess a power spectral density enriched in high-frequency components which is required for coherence protection. Our method provides a general framework for approximating arbitrary noise profiles, including the ubiquitous 1 / f spectrum prevalent in semiconductor devices, using only a finite set of simple noises. Numerical simulations confirm that a noise field synthesized from a sufficiently large number of OU processes preserves coherence significantly better than one constructed from just a few components. This work establishes noise engineering as a practical tool for coherence management and offers a versatile model for simulating complex noise environments in quantum information platforms.},
author = {Tao, Wenhui and Ma, Junzhe and Liu, Meng and Chen, Hongxiang and Sun, Haowen and Yang, Xiuyi},
doi = {10.1088/1612-202X/ae4f76},
issn = {1612-2011},
journal = {Laser Phys. Lett.},
mendeley-groups = {Open Quantum Systems/Fighting decoherence},
month = {mar},
number = {3},
pages = {035201},
title = {{Quantum coherence protection in semiconductor qubits via composite noise}},
url = {https://iopscience.iop.org/article/10.1088/1612-202X/ae4f76},
volume = {23},
year = {2026}
}
