journal = {Classical and Quantum Gravity},
month = {jan},
number = {1},
pages = {015028},
title = {{Jaynes–Cummings model in a weak gravitational wave background}},
url = {https://iopscience.iop.org/article/10.1088/1361-6382/ad134f},
volume = {41},
year = {2024}
