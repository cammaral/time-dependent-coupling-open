@article{Tsutsui2025a,
abstract = {This paper offers educational insight into the Dirac equation, examining its historical context and contrasting it with the earlier Schr{\"{o}}dinger and Klein-Gordon equations. The comparison highlights their Lorentz transformation symmetry and potential probabilistic interpretations. We explicitly solve the free particle dynamics in Dirac's model, revealing the emergence of solutions with negative energy. In this discussion, we examine the Dirac Sea Hypothesis and explore the inherent helicity of the solutions. Additionally, we demonstrate how the Dirac equation accounts for spin and derive the Pauli equation in the non-relativistic limit. Through the Foldy-Wouthuysen transformation, we reveal how the equation incorporates spin-orbit interaction and other relativistic effects, ultimately leading to the hydrogen fine structure. A section on relativistic covariant notation is included to emphasize the invariance of the Dirac equation, along with more refined formulations of both the KG and Dirac equations. Designed for undergraduate students with an interest in the Dirac equation, this resource provides a historical perspective without being purely theoretical. Our approach underscores the significance of a pedagogical method that combines historical and comparative elements to profoundly understand the role of the Dirac equation in modern physics.},
author = {Tsutsui, Thiago Takaji and Silva, Edilberto O and {Magalh{\~{a}}es de Castro}, Antonio S{\'{e}}rgio S M and Andrade, Fabiano M},
doi = {10.1088/1361-6404/adf9a5},
file = {:C\:/Users/takaj/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Tsutsui et al.. European Journal of Physics. 2025. The Dirac equation historical context, comparisons with the Schr{\"{o}}dinger and Klein-Gor.pdf:pdf},
issn = {0143-0807},
journal = {European Journal of Physics},
month = {aug},
title = {{The Dirac equation: historical context, comparisons with the Schr{\"{o}}dinger and Klein-Gordon equations, and elementary consequences}},
url = {https://iopscience.iop.org/article/10.1088/1361-6404/adf9a5},
year = {2025}
}
