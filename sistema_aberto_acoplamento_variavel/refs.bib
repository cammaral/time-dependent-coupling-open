@article{Zhang2014,
abstract = {The minimal time a system needs to evolve from an initial state to its one orthogonal state is defined as the quantum speed limit time, which can be used to characterize the maximal speed of evolution of a quantum system. This is a fundamental question of quantum physics. We investigate the generic bound on the minimal evolution time of the open dynamical quantum system. This quantum speed limit time is applicable to both mixed and pure initial states. We then apply this result to the damped Jaynes-Cummings model and the Ohimc-like dephasing model starting from a general time-evolution state. The bound of this time-dependent state at any point in time can be found. For the damped Jaynes-Cummings model, when the system starts from the excited state, the corresponding bound first decreases and then increases in the Markovian dynamics. While in the non-Markovian regime, the speed limit time shows an interesting periodic oscillatory behavior. For the case of Ohimc-like dephasing model, this bound would be gradually trapped to a fixed value. In addition, the roles of the relativistic effects on the speed limit time for the observer in non-inertial frames are discussed.},
author = {Zhang, Ying-Jie and Han, Wei and Xia, Yun-Jie and Cao, Jun-Peng and Fan, Heng},
doi = {10.1038/srep04890},
file = {:C\:/Users/takaj/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Zhang et al.. Scientific Reports. 2014. Quantum speed limit for arbitrary initial states.pdf:pdf},
issn = {2045-2322},
journal = {Scientific Reports},
month = {may},
number = {1},
pages = {4890},
title = {{Quantum speed limit for arbitrary initial states}},
url = {https://www.nature.com/articles/srep04890},
volume = {4},
year = {2014}
}
