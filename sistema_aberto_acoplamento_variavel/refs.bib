@article{SMIRMOV2016,
abstract = {Neste trabalho descrevemos uma classifica{\c{c}}{\~{a}}o geral das representa{\c{c}}{\~{o}}es da equa{\c{c}}{\~{a}}o de Dirac em 1+1 dimens{\~{o}}es. Na classifica{\c{c}}{\~{a}}o s{\~{a}}o inclu{\'{i}}das as representa{\c{c}}{\~{o}}es nas quais cada matriz de Dirac $\beta$, $\alpha$ {\'{e}} associada a uma {\'{u}}nica matriz de Pauli. Esta classifica{\c{c}}{\~{a}}o inclui 6 representa{\c{c}}{\~{o}}es principais. A inclus{\~{a}}o das representa{\c{c}}{\~{o}}es com sinais modificados das matrizes de Pauli aumenta o n{\'{u}}mero de representa{\c{c}}{\~{o}}es distintas at{\'{e}} 24. Determinamos as transforma{\c{c}}{\~{o}}es unit{\'{a}}rias entre todas as representa{\c{c}}{\~{o}}es na forma expl{\'{i}}cita. O estudo da estrutura do conjunto das transforma{\c{c}}{\~{o}}es leva {\`{a}} conclus{\~{a}}o de que todas as representa{\c{c}}{\~{o}}es s{\~{a}}o equivalentes, isto {\'{e}}, uma representa{\c{c}}{\~{a}}o pode ser obtida a partir de qualquer outra por uma transforma{\c{c}}{\~{a}}o unit{\'{a}}ria. Estabelecemos que o conjunto das transforma{\c{c}}{\~{o}}es forma um grupo n{\~{a}}o abeliano com respeito ao produto matricial em classes de equival{\^{e}}ncia, definidas atrav{\'{e}}s da indistinguibilidade das transforma{\c{c}}{\~{o}}es que diferem por um fator de fase. Este grupo possui um subgrupo n{\~{a}}o trivial, o qual por sua vez cont{\'{e}}m dois subgrupos n{\~{a}}o triviais. Apresentamos a forma geral das matrizes de Dirac em 1+1 dimens{\~{o}}es determinada por 3 par{\^{a}}metros arbitr{\'{a}}rios. Demonstramos a exist{\^{e}}ncia de isomorfismo entre o par das matrizes de Dirac e o par de vetores unit{\'{a}}rios ortogonais. Apresentamos tamb{\'{e}}m aplica{\c{c}}{\~{o}}es dos resultados obtidos neste trabalho.},
author = {Smirnov, Andrei and {Farias Jr.}, Antonio Jorge Dantas},
doi = {10.1590/1806-9126-RBEF-2016-0056},
file = {:C\:/Users/takaj/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Smirnov, Farias Jr. - 2016 - Representa{\c{c}}{\~{o}}es da Equa{\c{c}}{\~{a}}o de Dirac em 11 Dimens{\~{o}}es.pdf:pdf},
issn = {1806-1117},
journal = {Revista Brasileira de Ensino de F{\'{i}}sica},
month = {sep},
number = {3},
title = {{Representa{\c{c}}{\~{o}}es da Equa{\c{c}}{\~{a}}o de Dirac em 1+1 Dimens{\~{o}}es}},
volume = {38},
year = {2016}
}
